# Copy to .env for LOCAL runs only (never commit .env). In GitHub use repository Secrets instead.
TWELVE_DATA_API_KEY=your_twelve_data_key_here
TELEGRAM_BOT_TOKEN=123456789:replace_with_new_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id

# Optional overrides (defaults shown are the original Pine Script defaults / safe values)
# STATE_PATH=state/state.json
# LOG_LEVEL=INFO
# LOOKBACK_CANDLES=7
# FIRST_RUN_SEND_LOOKBACK=1
# DAILY_SAFETY_MARGIN=40
# MAX_CREDITS_PER_RUN=40
# PO3_ALGORITHM_MODE=Small Manipulation
# PO3_BREAKOUT_METHOD=Wick
# PO3_TPSL_METHOD=Dynamic
# PO3_RISK=Normal
